<div class="row mt-2 mb-2" id="header">
    <% if back_url %>
        <div class="w-25">
        <%= link_to "< Back", back_url, { id: 'back-link', class: "btn btn-secondary btn-sm", data: { test: 'back-btn', turbo_action: 'advance' } } %>
        </div>
    <% end %>
    <h2 class="<%= back_url ? "w-50" : "w-100" %> text-center">
        <%= title %>
    </h2>
    <% if extra_header %>
        <div class="w-25 text-end">
            <%= raw extra_header %>
        </div>
    <% end %>
</div>
