<% map_id = "map-#{rand(1..1000000)}" %>

<div id="<%= map_id %>"
     data-controller="map"
     data-map-climb-path="<%= climb_path(@climb) %>"
     data-map-routes="<%= routes.to_json %>"
     data-map-default-map-tint="<%= route_sets.first&.grade&.map_tint_colour %>"
     data-map-previous-states="<%= previous_states.to_json %>"
     data-map-new-wins="<%= new_wins.to_json %>"
     data-map-floorplan-data="<%= floorplan_data.to_json %>"
     data-map-initial-route-states="<%= initial_route_states.to_json %>"
     data-map-editable="<%= editable %>"
     data-map-show-new-win-star="<%= show_new_win_star %>">
  <% if lockable %> 
    <div class="row mx-1 mb-1 flex flex-row justify-content-between">
      <input type="date" value="<%= @climb.climbed_at %>" class="form-control w-50" id="climbedAt">
      <button class="btn bg-white w-25" id="lock" data-map-target="lock">🔓</button>
    </div>
  <% end %>

  <% if route_sets.count > 1 %>
  <div class="row mx-1 mb-1 flex flex-row" id="routeSetsContainer" data-test="route-set-picker">
    <% route_sets.each do |route_set| %>
      <button style="background-color: <%= route_set.grade.map_tint_colour %>; <%= 'color: white !important;' if colour_dark?(route_set.grade.map_tint_colour) %>" data-route-set-id="<%= route_set.id %>" data-grade="<%= route_set.grade.id %>" data-tint-colour="<%= route_set.grade.map_tint_colour %>" class="btn" data-map-target="routeSetButton">
        <span>
          <%= route_set.grade.name.titleize %>
        </span>
      </button>
    <% end %>
  </div>
  <% end %>

  <div style="display: flex;">
    <button data-action="click->map#prev" data-map-target="prevButton" class="floorplan-prev">&lt;</button>
    <span style="flex-grow: 1; text-align: center" id="floorplan_name" data-map-target="floorplanName"></span>
    <button data-action="click->map#next" data-map-target="nextButton" class="floorplan-next">&gt;</button>
  </div>
  <div class="map" data-map-target="map" style="background-color: <%= route_sets.first&.grade&.map_tint_colour %>">
    <% @place.floorplan.data.each_with_index do |floor, index| %>
      <img src="<%= url_for(@place.floorplan.images.find(floor['image_id'])) %>" class="floorplan" data-map-target="floorplan" data-floorplan-id="<%= index %>" style="opacity: 0.8" />
    <% end %>
  </div>
</div>
