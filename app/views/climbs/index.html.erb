<turbo-stream action="replace" target="header">
  <template>
    <%= render "shared/header", 
               back_url: menu_path,
               title: "Climbs!",
               extra_header: button_to("Add", climbs_path(method: :post), { class: "btn btn-primary btn-sm", data: { test: 'add' } })
    %>
  </template>
</turbo-stream>

<%= turbo_stream_from @user %>

<%= turbo_frame_tag "main-content" do %>
  <% if @climbs.any? %>
    <div class="card">
      <div class="row">
        <div class="d-table col-12" id="climbs">
          <%= render @climbs %>
        </div>
      </div>
    </div>
  <% end %>
<% end %>
