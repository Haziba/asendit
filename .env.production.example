# Production Environment Variables for Coolify
# Copy this file to your Coolify environment variables

# Rails Configuration
RAILS_ENV=production
SECRET_KEY_BASE=your_secret_key_base_here_generate_with_rails_secret

# Database Configuration
DATABASE_URL=postgresql://username:password@hostname:5432/database_name

# Rails Specific
RAILS_SERVE_STATIC_FILES=true
RAILS_LOG_TO_STDOUT=true

# Auth0 Configuration (if using Auth0)
AUTH0_DOMAIN=your-auth0-domain.auth0.com
AUTH0_CLIENT_ID=your_auth0_client_id
AUTH0_CLIENT_SECRET=your_auth0_client_secret

# Optional: Redis URL if you add Redis later
# REDIS_URL=redis://username:password@hostname:6379/0

# Optional: Enable CORS for your frontend domain
# CORS_ORIGINS=https://yourfrontend.com,https://www.yourfrontend.com